---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url as buildUrl } from "@/utils/url-utils";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags?: string[];
	category?: string | null;
	image?: string;
	description?: string;
	draft?: boolean;
	pinned?: boolean;
	password?: boolean;
	style?: string;
	loading?: "lazy" | "eager";
}

const {
	entry,
	title,
	url,
	published,
	category,
	description,
	pinned,
	password,
	style,
} = Astro.props;

const className = Astro.props.class;

// 自动摘要（frontmatter 没写 description 时用正文开头）
const { remarkPluginFrontmatter } = await render(entry);
const descriptionText = password
	? i18n(I18nKey.passwordProtectedDesc)
	: description || remarkPluginFrontmatter.excerpt || "";

// 日期标签：NOV 14
const dateLabel = new Intl.DateTimeFormat("en-US", {
	month: "short",
	day: "2-digit",
	timeZone: siteConfig.timezone || undefined,
})
	.format(published)
	.toUpperCase()
	.replace(",", "");

const hasCategory = !!category;
const href = url.startsWith("http") ? url : buildUrl(url);
---

<a
  class:list={["ps-post-item", "post-card-item", className]}
  href={href}
  style={style}
  aria-label={title}
>
  <div class="ps-post-meta">
    <span>{dateLabel}</span>
    {hasCategory && <span class="ps-post-meta-sep">·</span>}
    {hasCategory && <span>{category}</span>}
    {pinned && (
      <>
        <span class="ps-post-meta-sep">·</span>
        <span>PINNED</span>
      </>
    )}
  </div>

  <h2 class="ps-post-title">{title}</h2>

  {descriptionText && (
    <p class:list={["ps-post-desc", { "ps-post-locked": password }]}>
      {descriptionText}
    </p>
  )}
</a>
