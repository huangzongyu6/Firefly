---
import { Icon } from "astro-icon/components";
import { mobileNavConfig } from "@/config/mobileNavConfig";
import { url } from "@/utils/url-utils";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string): boolean => {
	const target = href.replace(/\/+$/, "") || "/";
	if (target === "/") return pathname === "/";
	return pathname === target || pathname.startsWith(`${target}/`);
};
---

<nav class="ps-tabbar" aria-label="移动端导航">
  {
    mobileNavConfig.tabs.map((tab) => (
      <a
        class:list={["ps-tab", { "is-active": isActive(tab.url) }]}
        href={url(tab.url)}
        data-url={url(tab.url)}
        aria-current={isActive(tab.url) ? "page" : undefined}
      >
        <Icon is:inline name={tab.icon} class="ps-tab-icon" />
        <span>{tab.name}</span>
      </a>
    ))
  }

  <button class="ps-tab ps-tab-more" type="button" id="ps-more-toggle" aria-expanded="false">
    <Icon is:inline name="material-symbols:more-horiz" class="ps-tab-icon" />
    <span>更多</span>
  </button>
</nav>

<div class="ps-sheet-backdrop" id="ps-sheet-backdrop" hidden></div>

<div class="ps-sheet" id="ps-sheet" hidden>
  <div class="ps-sheet-handle"></div>
  <div class="ps-sheet-links">
    {
      mobileNavConfig.more.map((item) => (
        <a class="ps-sheet-link" href={url(item.url)}>
          <span>{item.name}</span>
          <Icon
            is:inline
            name="material-symbols:chevron-right-rounded"
            class="ps-sheet-chevron"
          />
        </a>
      ))
    }
  </div>
</div>

<script>
	// 底部 Tab：点击后立即高亮 + Swup 换页后按路径重新计算
	const normalize = (p: string) => p.replace(/\/+$/, "") || "/";

	function updateActiveTabs() {
		const path = normalize(location.pathname);
		document.querySelectorAll<HTMLElement>(".ps-tab[data-url]").forEach((el) => {
			const target = normalize(el.dataset.url || "/");
			const active =
				target === "/" ? path === "/" : path === target || path.startsWith(`${target}/`);
			el.classList.toggle("is-active", active);
			if (active) el.setAttribute("aria-current", "page");
			else el.removeAttribute("aria-current");
		});
	}

	// 点击时立刻高亮，不等页面切换
	document.addEventListener("click", (event) => {
		const link = (event.target as HTMLElement | null)?.closest<HTMLElement>(
			".ps-tab[data-url]",
		);
		if (!link) return;
		document
			.querySelectorAll<HTMLElement>(".ps-tab[data-url]")
			.forEach((el) => el.classList.remove("is-active"));
		link.classList.add("is-active");
	});

	// 换页完成后按真实 URL 校正
	document.addEventListener("swup:page:view", updateActiveTabs);
	document.addEventListener("astro:page-load", updateActiveTabs);
	window.addEventListener("load", updateActiveTabs);
	window.addEventListener("popstate", updateActiveTabs);
</script>

<script is:inline>
	(function () {
		var toggle = document.getElementById("ps-more-toggle");
		var sheet = document.getElementById("ps-sheet");
		var backdrop = document.getElementById("ps-sheet-backdrop");
		if (!toggle || !sheet || !backdrop) return;

		function open() {
			sheet.hidden = false;
			backdrop.hidden = false;
			requestAnimationFrame(function () {
				sheet.classList.add("is-open");
				backdrop.classList.add("is-open");
			});
			toggle.setAttribute("aria-expanded", "true");
		}

		function close() {
			sheet.classList.remove("is-open");
			backdrop.classList.remove("is-open");
			toggle.setAttribute("aria-expanded", "false");
			setTimeout(function () {
				sheet.hidden = true;
				backdrop.hidden = true;
			}, 220);
		}

		function isOpen() {
			return sheet.classList.contains("is-open");
		}

		toggle.addEventListener("click", function () {
			isOpen() ? close() : open();
		});
		backdrop.addEventListener("click", close);
		document.addEventListener("keydown", function (e) {
			if (e.key === "Escape" && isOpen()) close();
		});
	})();
</script>
